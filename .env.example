# Backend API base URL used by browser requests.
# Local default: use the Vite proxy and keep frontend requests same-origin.
VITE_API_URL=/api

# Optional: enables Vite dev-server proxy from /api to the backend.
# For a backend running directly on your machine, use http://localhost:3000.
VITE_API_PROXY_TARGET=http://localhost:3000

# Supabase Auth browser config. Use the public anon key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: public CDN/storage base URL for sticker images.
# Leave empty when serving images from public/stickers locally.
# Example: https://cdn.example.com/album-assets
VITE_STICKER_ASSET_BASE_URL=
