# Docker default: browser calls the frontend at /api, and Vite proxies to the backend service.
VITE_API_URL=/api

# This assumes the backend service is named "backend" in the Docker network.
# If your backend compose uses another service name or port, change this value.
VITE_API_PROXY_TARGET=http://backend:3000

# Supabase Auth browser config. Use the public anon key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
